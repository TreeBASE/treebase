# Environment variables for Docker Compose
# Copy this file to .env and customize as needed
# Note: .env file is automatically loaded by docker compose

# PostgreSQL Database Configuration
POSTGRES_DB=treebase
POSTGRES_USER=treebase
POSTGRES_PASSWORD=treebase

# Application Configuration
APP_PORT=8080

# Java/Tomcat Configuration  
JAVA_OPTS=-Xmx512m -XX:+UseG1GC

# Database Connection (for application)
DB_HOST=postgres
DB_PORT=5432

# Site Configuration
SITE_URL=http://localhost:8080/treebase-web/
PURL_BASE=http://treebase.org/treebase-web/phylows/

# Email Configuration
SMTP_HOST=localhost

# Mesquite Configuration
MESQUITE_FOLDER=/usr/local/mesquite
