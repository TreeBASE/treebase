			<url>https://repository.jboss.org/nexus/content/groups/public/org/tuckey/urlrewritefilter</url>
		</repository>      
    	<repository>
      		<id>java.net</id>
      		<url>https://download.java.net/maven/2</url>
    	</repository>
    	<repository>
    		<id>maven.indexdata.com</id>
